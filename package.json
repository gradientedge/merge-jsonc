{
  "name": "@gradientedge/merge-jsonc",
  "version": "0.0.0-development",
  "description": "JSON/JSONC/JSON5 deep-merger CLI for Node 22+",
  "license": "MIT",
  "author": "Gradient Edge",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gradientedge/merge-jsonc.git"
  },
  "bugs": {
    "url": "https://github.com/gradientedge/merge-jsonc/issues"
  },
  "homepage": "https://github.com/gradientedge/merge-jsonc#readme",
  "keywords": ["json", "jsonc", "json5", "merge", "cli", "config", "configuration", "deep-merge"],
  "publishConfig": {
    "access": "public"
  },
  "release": {
    "branches": ["main"]
  },
  "type": "module",
  "bin": {
    "merge-jsonc": "dist/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./cli": {
      "import": "./dist/cli.mjs"
    }
  },
  "types": "dist/index.d.ts",
  "main": "dist/index.mjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "npm run build",
    "test": "vitest run --coverage",
    "validate": "npm run format:check && npm run lint && npm run test",
    "prepublishOnly": "npm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "deepmerge": "^4.3.1",
    "json5": "^2.2.3",
    "jsonc-parser": "^3.3.1",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@eslint/js": "^9.39.1",
    "@semantic-release/changelog": "^6.0.3",
    "@types/node": "^24.10.1",
    "@types/yargs": "^17.0.35",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "@vitest/coverage-v8": "^4.0.15",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "semantic-release": "^25.0.2",
    "tsdown": "^0.17.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  },
  "files": ["dist"],
  "sideEffects": false,
  "lint-staged": {
    "src/**/*.{ts,tsx}": ["prettier --write", "eslint --fix --max-warnings=0"],
    "test/**/*.{ts,tsx}": ["prettier --write", "eslint --fix --max-warnings=0"],
    "*.config.{js,ts}": ["prettier --write"],
    "*.{js,cjs}": ["prettier --write"],
    "**/*.{json,jsonc,md,mdx,yml,yaml}": "prettier --write"
  }
}
